    <changeSet id="202610181511-create-entity-user-documents" author="devricardorocha">
        <createTable tableName="user_documents">
            <column name="user_id" type="UUID"><constraints primaryKey="true" nullable="false" primaryKeyName="pk_user_documents"/></column>
