<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="202610181511-create-entity-users" author="devricardorocha">
        <createTable tableName="users">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false" primaryKeyName="pk_users"/></column>
            <column name="version" type="INTEGER"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"><constraints nullable="false"/></column>
            <column name="created_by" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="last_modified_at" type="TIMESTAMP WITHOUT TIME ZONE"><constraints nullable="false"/></column>
            <column name="last_modified_by" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="external_id" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="code" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="email" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="first_name" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="last_name" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="birth_date" type="DATE"><constraints nullable="false"/></column>
            <column name="gender" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="nationality" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="marital_status" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="profile_photourl" type="VARCHAR(256)"/>
            <column name="hiring_date" type="DATE"><constraints nullable="false"/></column>
            <column name="job_title" type="VARCHAR(16)"/>
            <column name="manager_id" type="UUID"/>
            <column name="active" type="BOOLEAN"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
